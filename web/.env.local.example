# Copy to .env.local (git-ignored) and fill in. Read only by the Vite dev
# server, which forwards the coach's requests to the provider's API with the
# key attached; the key is never sent to the browser.

# Gemini (used when set). Free keys: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude (used when GEMINI_API_KEY is empty). Keys: https://console.anthropic.com
# (billed separately from a Claude Pro/Max subscription).
ANTHROPIC_API_KEY=

# Optional overrides
# COACH_PROVIDER=gemini   # gemini | anthropic (default: whichever key is set, Gemini first)
# COACH_MODEL=gemini-3.5-flash-lite   # default for Gemini; claude-opus-5 for Claude
# COACH_EFFORT=medium     # Claude only: low | medium | high | xhigh | max
