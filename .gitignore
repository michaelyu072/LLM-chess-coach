# Local Python environment and caches
.venv/
__pycache__/
.DS_Store

# Lichess's source clone (854 MB, its own git repo). The app only needs the
# board/piece/sound files copied out of it, which are committed in web/public/lila.
/lila/

# Raw Lichess puzzle dump (290 MB; GitHub rejects files over 100 MB).
# Download from https://database.lichess.org/#puzzles
*.csv.zst

# Pipeline intermediate (48 MB), regenerated by pipeline/filter.py
data/selected.jsonl
